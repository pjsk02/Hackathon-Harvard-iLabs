# Copy to .env for local development. Never commit real credentials.
# npm run dev and npm start load .env; existing shell variables take precedence.
PORT=5000
ISSUER_PRIVATE_KEY=
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Real-chain configuration, with live sends paused. No mock application mode.
MOCK_CHAIN=0
# Keep at zero until a separate bounded live-test allowance is approved.
MONAD_MAX_TRANSACTIONS=0
# Direct Anthropic credentials for local development; no Replit integration needed.
ANTHROPIC_API_KEY=
USE_OWN_KEY=1
AGENT_MODEL=claude-haiku-4-5
