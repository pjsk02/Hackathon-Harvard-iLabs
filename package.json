{
  "name": "envoi",
  "version": "1.0.0",
  "private": true,
  "description": "Envoi hackathon demo: permission slip, bouncer and public record on Monad.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/run.mjs development",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx scripts/run.mjs production",
    "typecheck": "tsc --noEmit",
    "test:state": "node --import tsx --test server/state.test.ts",
    "test:chain": "node --import tsx --test server/chain/chain.test.ts server/chain/permission-service.test.ts server/chain/rpc-safety.test.ts server/chain/attempt-recording.test.ts",
    "test:agent": "node --import tsx --test server/agent/integration.test.ts",
    "test:client": "node --import tsx --test client/tests/request.test.ts client/tests/attempt-evidence.test.ts client/tests/attempt-request.test.ts",
    "test:ui": "node --import tsx --test --test-concurrency=1 client/tests/workspace-ui.test.ts",
    "test:storage": "node --import tsx --test server/storage/repository.test.ts",
    "test:p2": "node scripts/test-p2.mjs",
    "test:context": "node --import tsx --test server/gateway/tests/workspace-context.test.ts",
    "db:push": "node --env-file-if-exists=.env --import tsx scripts/migrate-development.ts",
    "test": "npm run test:state && npm run test:chain && npm run test:agent && npm run test:client && npm run test:context"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pjsk02/Hackathon-Harvard-iLabs.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "puppeteer-core": "^25.16.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
